# Copy to .env and fill in what you need. Everything is optional:
# without ANTHROPIC_API_KEY the app runs in mock mode with sample data.

# Anthropic API key. Leave empty for mock mode.
ANTHROPIC_API_KEY=

# Model used for the AI step. Change this to any model your key can access.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Force mock mode even when a key is set (useful for demos).
MOCK_MODE=false

# Bearer token for POST /api/refresh. If empty, the endpoint is disabled.
REFRESH_TOKEN=

# Salt for anonymous visitor hashes. Set your own value in any shared deployment.
VISITOR_SALT=change-me
